model Flight {
  id                                   BigInt    @id @db.UnsignedBigInt
  flightNum                            String    @db.VarChar(32)
  flightDate                           DateTime  @db.DateTime(3)
  flightMissionProperty                String    @db.VarChar(32)
  aircraft                             String    @db.VarChar(32)
  aircraftIata                         String    @db.VarChar(32)
  intDomType                           String    @db.VarChar(32)
  isRegionFlight                       Boolean
  vipFlag                              Int
  ioFlag                               String    @db.VarChar(32)
  arrivalAirport                       String    @db.VarChar(32)
  departureAirport                     String    @db.VarChar(32)
  sta                                  DateTime  @db.DateTime(3)
  eta                                  DateTime  @db.DateTime(3)
  ata                                  DateTime  @db.DateTime(3)
  std                                  DateTime  @db.DateTime(3)
  atd                                  DateTime  @db.DateTime(3)
  registrationNumber                   String    @db.VarChar(32)
  bodyType                             String    @db.VarChar(32)
  aircraftClass                        String    @db.VarChar(32)
  fleetType                            String    @db.VarChar(32)
  standId                              Int
  standName                            String    @db.VarChar(255)
  standType                            String    @db.VarChar(32)
  standAreaId                          Int
  standAreaName                        String    @db.VarChar(255)
  selfTaxiStand                        Boolean
  standApronId                         Int
  standApronCode                       String    @db.VarChar(32)
  standApronName                       String    @db.VarChar(255)
  airportRunway                        String    @db.VarChar(32)
  terminalBuilding                     String    @db.VarChar(32)
  terminalBuildingId                   Int
  baggageCarouselName                  String    @db.VarChar(255)
  baggageTurntableName                 String    @db.VarChar(255)
  flightStatus                         Int
  hasDomPaxIntFlight                   Boolean
  serviceTypeCode                      String    @db.VarChar(32)
  airportCode                          String    @db.VarChar(32)
  airlineCode                          String    @db.VarChar(32)
  airlineIcaoCode                      String    @db.VarChar(32)
  isStopover                           Boolean
  flightRoute                          String    @db.VarChar(32)
  flightRouteCn                        String    @db.VarChar(32)
  uniqueId                             String    @db.VarChar(64)
  relatedExternalId                    String    @db.VarChar(64)
  isPlanCancel                         Boolean
  updateUserId                         Int
  updateTime                           DateTime  @db.DateTime(3)
  tagIds                               Json
  expandProperties                     Json
  boardFirstPaxNum                     Int
  boardClubPaxNum                      Int
  boardEcoPaxNum                       Int
  firstPaxNum                          Int
  clubPaxNum                           Int
  ecoPaxNum                            Int
  boardCipPaxNum                       Int
  cipPaxNum                            Int
  boardSuperCipPaxNum                  Int
  superCipPaxNum                       Int
  ecoClassCipPaxNum                    Int
  highClassCipPaxNum                   Int
  boardHighClassCipPaxNum              Int
  boardEcoClassCipPaxNum               Int
  boardPaxNum                          Int
  paxNum                               Int
  pnrFirstPaxNum                       Int
  pnrClubPaxNum                        Int
  pnrEcoPaxNum                         Int
  pnrHighClassCipPaxNum                Int
  pnrEcoClassCipPaxNum                 Int
  pnrSpecialServicePaxNum              Int
  pnrThroughPaxNum                     Int
  pnrUnaccompaniedPaxNum               Int
  cpaxFirstPaxNum                      Int
  cpaxClubPaxNum                       Int
  cpaxEcoPaxNum                        Int
  cpaxHighClassCipPaxNum               Int
  cpaxEcoClassCipPaxNum                Int
  cpaxSpecialServicePaxNum             Int
  cpaxThroughPaxNum                    Int
  cpaxUnaccompaniedPaxNum              Int
  cpaxBaggageWeight                    Int
  cpaxBaggageNum                       Int
