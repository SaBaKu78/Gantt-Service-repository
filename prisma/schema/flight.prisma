  locationAreaName                     String    @db.VarChar(255)
  arrivalAirportShortName              String    @db.VarChar(255)
  departureAirportShortName            String    @db.VarChar(255)
  middleAirportShortName               String    @db.VarChar(255)
  firstDeparturePaxNum                 Int
  clubDeparturePaxNum                  Int
  ecoDeparturePaxNum                   Int
  departurePaxNum                      Int
  specialServicePaxNum                 Int
  throughPaxNum                        Int
  firstBaggageWeight                   Int
  clubBaggageWeight                    Int
  ecoBaggageWeight                     Int
  baggageWeight                        Int
  baggageNum                           Int
  unaccompaniedPaxNum                  Int
  cpaxNumInfo                          String    @db.VarChar(32)
  pnrPaxNumInfo                        String    @db.VarChar(32)
  paxNumInfo                           String    @db.VarChar(32)
  ecoClassCipPaxNumInfo                String    @db.VarChar(32)
  pilotMemberNum                       Int
  cabinMemberNum                       Int
  takeCrewMemberNum                    Int
  variableTaxiTime                     Int
  estTaxiInTime                        DateTime  @db.DateTime(3)
  actTaxiInTime                        DateTime  @db.DateTime(3)
