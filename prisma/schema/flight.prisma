  intConn                              Boolean
  calculatedIntDomType                 String    @db.VarChar(32)
  estimatedTime                        DateTime  @db.DateTime(3)
  domGateId                            BigInt?   @db.BigInt
  domGateName                          String?   @db.VarChar(255)
  domDebarkationSpotType               String?   @db.VarChar(32)
  linkedFlightNum                      String?   @db.VarChar(32)
  linkedFlightNumPassStationTimeMinute Int?
  linkedFlightRelatedExternalId        String?   @db.VarChar(64)
  linkedFlightSta                      DateTime? @db.DateTime(3)
  linkedFlightEta                      DateTime? @db.DateTime(3)
  linkedFlightAta                      DateTime? @db.DateTime(3)
  linkedFlightStd                      DateTime? @db.DateTime(3)
  linkedFlightAtd                      DateTime? @db.DateTime(3)
  calcTakeOffTime                      DateTime? @db.DateTime(3)
  calcOffBlockTime                     DateTime? @db.DateTime(3)

  @@unique([uniqueId])
  @@index([airportCode, flightDate])
  @@index([flightNum, flightDate])
  @@map("flights")
}
